{
  "name": "moose-proxy",
  "version": "0.2.0",
  "description": "Fast, conflict-safe bidirectional sync for code-server projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "moose-proxy": "dist/index.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration:prefix-proxy": "tsx test/integration/prefixProxy.ts",
    "test:integration:sync": "tsx test/integration/syncSmoke.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "14.0.2",
    "ignore": "7.0.6",
    "tough-cookie": "6.0.0",
    "undici": "7.28.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.7"
  }
}
